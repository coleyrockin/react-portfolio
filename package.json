{
  "name": "react-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Boyd Roberts' personal developer portfolio — React 19, Vite, deployed to GitHub Pages.",
  "author": "Boyd Roberts",
  "license": "MIT",
  "homepage": "https://coleyrockin.github.io/react-portfolio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/coleyrockin/react-portfolio.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "screenshot:readme": "node scripts/capture-readme.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.11.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
